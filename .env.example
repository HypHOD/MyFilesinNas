# 复制为 .env 后按需修改：cp .env.example .env
# Docker Compose 会自动读取仓库根目录的 .env。

# 外接 M.2 的宿主机挂载点
M2_ROOT=/mnt/m2

# Agent（缺失时站点照常启动，/api/agent 会返回未启用）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 宿主机用户 UID/GID（树莓派默认 ubuntu 用户通常是 1000）
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# 站点对外端口（80 被占用时改成 8080 等）
HTTP_PORT=80

# qBittorrent WebUI：
# 内网测试先绑 0.0.0.0 方便访问，设置强密码后建议改回 127.0.0.1 并用 SSH 隧道
QB_BIND=0.0.0.0
QB_HOST_PORT=8081
